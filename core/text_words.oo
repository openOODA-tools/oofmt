// # Text Words - Lexical Tokenizer and Utilities
//
// Logline: Word extraction, whitespace analysis, prefix stripping, and sentence boundary detection.
//
// Setup: Pure string manipulation functions without ambient authority or memory mutations.
//
// Beats:
//   1. Measure leading whitespace and line indentation levels.
//   2. Match and strip optional comment or quote prefixes.
//   3. Tokenize lines into whitespace-delimited word sequences.
//   4. Detect grammatical sentence endings for uniform spacing reflow.

pub fn is_whitespace_byte(b: Int) -> Bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

pub fn is_ascii_digit(b: Int) -> Bool {
    return b >= 48 && b <= 57;
}

pub fn parse_int_positive(s: String, default_val: Int) -> Int {
    let n: Int = chars_len(s);
    if n == 0 {
        return default_val;
    }
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if !is_ascii_digit(b) {
            return default_val;
        }
        acc = acc * 10 + (b - 48);
        i = i + 1;
    }
    return if acc > 0 { acc } else { default_val };
}

pub fn count_leading_spaces(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if b == 32 {
            count = count + 1;
        } else if b == 9 {
            count = count + 4; // Standard 4-space tab expansion
        } else {
            return count;
        }
        i = i + 1;
    }
    return count;
}

pub fn has_string_prefix(s: String, prefix: String) -> Bool {
    let p_len: Int = chars_len(prefix);
    let s_len: Int = chars_len(s);
    if p_len == 0 {
        return true;
    }
    if s_len < p_len {
        return false;
    }
    return str_slice(s, 0, p_len) == prefix;
}

pub fn strip_string_prefix(s: String, prefix: String) -> String {
    let p_len: Int = chars_len(prefix);
    let s_len: Int = chars_len(s);
    if p_len == 0 || s_len < p_len {
        return s;
    }
    if str_slice(s, 0, p_len) == prefix {
        return str_slice(s, p_len, s_len);
    }
    return s;
}

pub fn repeat_spaces(count: Int) -> String {
    let mut res: String = "";
    let mut i: Int = 0;
    while i < count {
        res = res + " ";
        i = i + 1;
    }
    return res;
}

pub fn split_into_words(line: String) -> List[String] {
    let mut words: List[String] = list_new();
    let n: Int = chars_len(line);
    let mut i: Int = 0;

    while i < n {
        while i < n && is_whitespace_byte(byte_at(line, i)) {
            i = i + 1;
        }
        if i >= n {
            break;
        }
        let start: Int = i;
        while i < n && !is_whitespace_byte(byte_at(line, i)) {
            i = i + 1;
        }
        let word: String = str_slice(line, start, i);
        if chars_len(word) > 0 {
            words = list_push(words, word);
        }
    }
    return words;
}

pub fn is_sentence_boundary(word: String) -> Bool {
    let n: Int = chars_len(word);
    if n == 0 {
        return false;
    }
    let last_b: Int = byte_at(word, n - 1);
    if last_b == 46 || last_b == 63 || last_b == 33 { // '.' or '?' or '!'
        return true;
    }
    // Also check trailing quotes: e.g. ." or ?" or !"
    if (last_b == 34 || last_b == 39) && n >= 2 {
        let prev_b: Int = byte_at(word, n - 2);
        if prev_b == 46 || prev_b == 63 || prev_b == 33 {
            return true;
        }
    }
    return false;
}
