// # oofmt IPC Subsystem Anchor
//
// Logline: Consolidates CLI argument parsing, JSON field extraction, and MCP server routines.
//
// Setup: Pure test harness validating IPC protocol handling and options parsing.
//
// Beats:
//   1. Re-export CLI option parser, JSON field decoder, and MCP server.
//   2. Assert CLI argument parsing invariants and flag extraction.
//   3. Assert MCP initialize and tools/list frame synthesis.

import "core/fmt_options.oo";
import "ipc/json_field.oo";
import "ipc/cli_options.oo";
import "ipc/mcp_server.oo";

fn assert_true(cond: Bool, msg: String) -> Bool {
    if !cond {
        print("FAIL: " + msg + "\n");
        return false;
    }
    return true;
}

fn str_contains(s: String, needle: String) -> Bool {
    let s_len: Int = chars_len(s);
    let n_len: Int = chars_len(needle);
    if n_len == 0 { return true; }
    if s_len < n_len { return false; }
    let mut i: Int = 0;
    while i + n_len <= s_len {
        if str_slice(s, i, i + n_len) == needle { return true; }
        i = i + 1;
    }
    return false;
}

pub fn run_ipc_tests() -> Bool {
    let mut ok: Bool = true;

    // Test 1: JSON field extraction
    let sample_json: String = "{\"id\":42,\"text\":\"hello world\",\"valid\":true}";
    ok = ok && assert_true(json_extract_int_field(sample_json, "id", 0) == 42, "json int extraction");
    ok = ok && assert_true(json_extract_str_field(sample_json, "text") == "hello world", "json str extraction");
    ok = ok && assert_true(json_extract_bool_field(sample_json, "valid", false), "json bool extraction");

    // Test 2: CLI argument parsing
    let mut args: List[String] = list_new();
    args = list_push(args, "-w");
    args = list_push(args, "65");
    args = list_push(args, "-s");
    args = list_push(args, "-p");
    args = list_push(args, "> ");
    args = list_push(args, "input.txt");

    let cfg: FmtConfig = parse_cli_args(args);
    ok = ok && assert_true(cfg.width == 65, "parsed width 65");
    ok = ok && assert_true(cfg.split_only, "parsed split-only");
    ok = ok && assert_true(cfg.prefix == "> ", "parsed prefix '> '");
    ok = ok && assert_true(list_len(cfg.files) == 1, "parsed one target file");

    // Test 3: Numeric shorthand flag (-50)
    let mut num_args: List[String] = list_new();
    num_args = list_push(num_args, "-50");
    let num_cfg: FmtConfig = parse_cli_args(num_args);
    ok = ok && assert_true(num_cfg.width == 50, "parsed shorthand -50 as width 50");

    // Test 4: MCP initialize frame
    let init_frame: String = handle_mcp_request("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}");
    ok = ok && assert_true(str_contains(init_frame, "protocolVersion"), "mcp initialize response");

    // Test 5: MCP tools/list frame
    let list_frame: String = handle_mcp_request("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{}}");
    ok = ok && assert_true(str_contains(list_frame, "fmt_format_text"), "mcp tools/list fmt_format_text");

    if ok {
        print("ALL oofmt ipc anchor tests PASSED\n");
    }
    return ok;
}
